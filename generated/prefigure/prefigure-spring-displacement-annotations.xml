      <position>1</position>
      <parents>
        <grouped>prefigure-spring-displacement-figure</grouped>
      </parents>
    </annotation>
    <annotation id="prefigure-spring-displacement-sa-floor" speech2="A hatched horizontal floor the block slides along.">
