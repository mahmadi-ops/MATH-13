      <parents>
        <grouped>prefigure-spring-displacement-figure</grouped>
      </parents>
    </annotation>
    <annotation id="prefigure-spring-displacement-sa-parabola" speech2="The graph of the potential energy U equals one half k x squared, an upward opening parabola with its vertex at the equilibrium position. It is symmetric, so stretching and compressing by the same amount store the same energy.">
      <active>prefigure-spring-displacement-sa-parabola</active>
      <position>9</position>
      <parents>
        <grouped>prefigure-spring-displacement-figure</grouped>
      </parents>
    </annotation>
    <annotation id="prefigure-spring-displacement-sa-energy" speech2="The point on the parabola directly below the block, giving the energy one half k x squared stored in the spring at that displacement.">
      <active>prefigure-spring-displacement-sa-energy</active>
