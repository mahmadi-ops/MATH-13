      <position>2</position>
      <parents>
        <grouped>prefigure-spring-displacement-figure</grouped>
      </parents>
    </annotation>
    <annotation id="prefigure-spring-displacement-sa-spring" speech2="The spring, drawn as a blue coil running from the wall to the block.">
      <active>prefigure-spring-displacement-sa-spring</active>
      <position>3</position>
      <parents>
        <grouped>prefigure-spring-displacement-figure</grouped>
      </parents>
    </annotation>
    <annotation id="prefigure-spring-displacement-sa-block" speech2="The block of mass m, pulled to the right of its equilibrium position so that the spring is stretched.">
      <active>prefigure-spring-displacement-sa-block</active>
      <position>4</position>
      <parents>
        <grouped>prefigure-spring-displacement-figure</grouped>
      </parents>
    </annotation>
    <annotation id="prefigure-spring-displacement-sa-equilibrium" speech2="A dashed vertical line marking the equilibrium position, where x equals zero. It runs the full height of the figure, linking the block picture above to the energy graph below.">
      <active>prefigure-spring-displacement-sa-equilibrium</active>
      <position>5</position>
      <parents>
        <grouped>prefigure-spring-displacement-figure</grouped>
      </parents>
    </annotation>
    <annotation id="prefigure-spring-displacement-sa-displacement" speech2="A double headed arrow between the equilibrium line and the block, marking the displacement x.">
      <active>prefigure-spring-displacement-sa-displacement</active>
      <position>6</position>
      <parents>
        <grouped>prefigure-spring-displacement-figure</grouped>
      </parents>
    </annotation>
    <annotation id="prefigure-spring-displacement-sa-xaxis" speech2="The horizontal axis of the energy graph, labelled x, on the same scale as the picture above it.">
      <active>prefigure-spring-displacement-sa-xaxis</active>
      <position>7</position>
      <parents>
        <grouped>prefigure-spring-displacement-figure</grouped>
      </parents>
    </annotation>
    <annotation id="prefigure-spring-displacement-sa-Uaxis" speech2="The vertical axis of the energy graph, labelled U, rising from the equilibrium position.">
