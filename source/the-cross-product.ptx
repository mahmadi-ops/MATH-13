      <label font-size="18" at="mb-b40" anchor="(3.7,-3.4)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b01" anchor="(-3.7,-1.25)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b11" anchor="(-1.85,-1.25)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b21" anchor="(0,-1.25)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b41" anchor="(3.7,-1.25)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b02" anchor="(-3.7,1.25)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b12" anchor="(-1.85,1.25)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b22" anchor="(0,1.25)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b42" anchor="(3.7,1.25)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b03" anchor="(-3.7,3.4)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b13" anchor="(-1.85,3.4)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b23" anchor="(0,3.4)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b33" anchor="(1.85,3.4)" alignment="c" color="#7A5AA8"><m>\times</m></label>
      <label font-size="18" at="mb-b43" anchor="(3.7,3.4)" alignment="c" color="#7A5AA8"><m>\times</m></label>

      <!-- the circular orbit, with an arrowhead showing the sense of circulation -->
      <circle at="mb-orbit" center="(0,0)" radius="2.4"
              stroke="#9EC5E8" thickness="2" fill="none"/>
      <arc at="mb-dir" center="(0,0)" radius="2.4" range="(58,112)" degrees="yes"
           stroke="#0072B2" thickness="3" arrows="1"/>

      <!-- radius to the particle -->
      <line at="mb-r" p1="(0,0)" p2="(2.4,0)" stroke="#999999" thickness="1.4" dash="4 3"/>

      <!-- velocity (tangent, counter-clockwise) and magnetic force (toward centre) -->
      <vector at="mb-v" tail="(2.4,0)" v="(0,1.75)" stroke="#0072B2" thickness="3"/>
      <vector at="mb-F" tail="(2.4,0)" v="(-1.4,0)" stroke="#D55E00" thickness="3"/>
      <angle-marker font-size="18" at="mb-right" points="((2.4,1),(2.4,0),(1.4,0))"
                    radius="17" stroke="black"/>

      <point at="mb-O" p="(0,0)" fill="black" size="3"/>
      <point at="mb-P" p="(2.4,0)" fill="black" size="4"/>

      <label font-size="18" at="mb-Ol" anchor="(-0.12,-0.14)" alignment="sw"><m>O</m></label>
      <label font-size="18" at="mb-rl" anchor="(0.62,-0.16)" alignment="s" color="#666666"><m>r</m></label>
      <label font-size="18" at="mb-vl" anchor="(2.52,1.78)" alignment="ne" color="#0072B2"><m>\vec v</m></label>
